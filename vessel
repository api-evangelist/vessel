egrations.", "desc_source": "apis.yml:description", "topics": ["apis-json", "google-workspace", "team-chat", "messaging", "collaboration", "chat-apps", "spaces", "slash-commands", "bots"], "topics_source": "apis.yml:tags"}, {"slug": "google-chrome", "name": "Google Chrome", "description": "Collection of APIs and resources for the Google Chrome browser and Chrome platform.", "desc_source": "apis.yml:description", "topics": ["apis-json", "browser", "chrome-extensions", "developer-tools", "web-platform"], "topics_source": "apis.yml:tags"}, {"slug": "google-classroom", "name": "Google Classroom", "description": "The Google Classroom API provides programmatic access to Google Classroom, enabling management of courses, coursework, student submissions, rosters, and invitations. It supports creating and organizing courses, distributing assignments and materials, managing student and teacher enrollments, tracking submissions and grades, and integrating with\u2026", "desc_source": "apis.yml:description", "topics": ["apis-json", "assignments", "classroom", "courses", "education", "google", "google-workspace", "students"], "topics_source": "apis.yml:tags"}, {"slug": "google-cloud", "name": "Google Cloud Platform", "description": "Google Cloud Platform provides a comprehensive suite of cloud computing services including compute, storage, databases, machine learning, and networking capabilities.", "desc_source": "apis.yml:description", "topics": ["apis-json", "cloud-computing", "data-analytics", "infrastructure", "machine-learning", "platform-as-a-service"], "topics_source": "apis.yml:tags"}, {"slug": "google-cloud-api-gateway", "name": "Google Cloud API Gateway", "description": "Google Cloud API Gateway enables you to provide secure access to your backend services through a well-defined REST API that is consistent across all of your services. It is a fully managed, pay-per-use gateway designed for serverless workloads, supporting Cloud Functions, Cloud Run, and App Engine backen